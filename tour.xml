<krpano version="1.24" title="Virtual Tour">

	<!--
	    No skin.

	    krpano's stock vtourskin.xml (and its design include, and the
	    skin_settings block that configured it) used to live here. It drew its
	    control bar as sprite crops inside the WebGL canvas, which meant it
	    could not take colours from the page, could not be reached by keyboard,
	    and needed an XML edit for every change. It has been replaced wholesale
	    by controlbar.js, which builds real DOM buttons over the canvas — see
	    index.html, which loads it from embedpano's onready.

	    If you re-tile this tour, krpano will regenerate skin/ and write a fresh
	    tour.xml that includes it again. Keep a copy of this file.
	-->

	<!--
	    Loading the first scene was the skin's job (its skin_onstart_loadscene
	    action). Without a replacement the viewer starts up on an empty black
	    canvas, so the bootstrap is restated here.

	    Both query parameters index.html forwards are honoured: startscene picks
	    the scene, startlookat restores a shared viewing direction.
	-->
	<action name="startup" autorun="onstart">
		loadscene(calc(isset(startscene) ? startscene : 0), null, MERGE);

		if(isset(startlookat),
			txtsplit(startlookat, ',', hlookat,vlookat,fov,distortion,architectural);
			lookat(get(hlookat),get(vlookat),get(fov),get(distortion),get(architectural));
		);
	</action>

	<!-- Drives the control bar's VR button. A plugin, not skin, so it is
	     unaffected by the skin removal and carries no skin_* references. -->
	<include url="plugins/webvr.xml" />

	<!--
	    webvr.xml ships its own "Enter VR" layer, which krpano stamps across the
	    top of the sky the moment VR reports available - and with
	    mobilevr_fake_support it reports available on an ordinary desktop too.
	    The control bar already has a VR button, so the plugin's one is removed.

	    The exception is device.mobilevr: there the page is already being viewed
	    inside a headset browser, where the full-width button is the way in and
	    a 36px DOM button is not. Same test the stock skin used.

	    Declared after the include so it merges into the plugin element by name,
	    overriding onavailable; the original handler is then called by hand so
	    the rest of the plugin's startup still happens.
	-->
	<action name="webvr_hide_plugin_button">
		if(device.mobilevr == false, removelayer(webvr_enterbutton); );
	</action>

	<plugin name="webvr" onavailable="webvr_hide_plugin_button(); webvr_onavailable();" />

	<scene name="scene_panosphere_render" title="panosphere_render" onstart="" thumburl="panos/panosphere_render.tiles/thumb.jpg" lat="" lng="" alt="" heading="">

		<control bouncinglimits="calc:image.cube ? true : false" />

		<!-- fovmin removed on purpose: maxpixelzoom already stops the zoom at 1:1
		     with the tiles, so a 70 degree floor only cut the zoom short. -->
		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="120" maxpixelzoom="1.0" fovmax="140" limitview="auto" />

		<preview url="panos/panosphere_render.tiles/preview.jpg" />

		<image>
			<cube url="panos/panosphere_render.tiles/%s/l%l/%0v/l%l_%s_%0v_%0h.jpg" multires="512,640,1280,2560,5120" />
		</image>

	</scene>

</krpano>
